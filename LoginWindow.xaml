<Window x:Class="TradingCompany.WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вхід у систему" Height="350" Width="300" 
        WindowStartupLocation="CenterScreen"
        Background="#FFF3F3F3">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Авторизація" FontSize="20" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#FF333333"/>

            <TextBlock Text="Логін:" FontSize="14" Foreground="#FF555555" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource ModernTextBoxStyle}" />

            <TextBlock Text="Пароль:" FontSize="14" Foreground="#FF555555" Margin="0,0,0,5"/>
            
            <PasswordBox x:Name="pwdPassword" Margin="0,0,0,20" Padding="8,5" FontSize="14" />

            <Button Content="Увійти" 
                    Click="BtnLogin_Click"
                    Style="{StaticResource ModernButtonStyle}"/>

            <TextBlock Text="{Binding ErrorMessage}" 
                       Foreground="#FFD13438" 
                       Margin="0,15,0,0" 
                       TextWrapping="Wrap" 
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>