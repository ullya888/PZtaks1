<Window x:Class="TradingCompany.WPF.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Products">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="10">
        <DataGrid ItemsSource="{Binding Products}" AutoGenerateColumns="True" IsReadOnly="True" />

    
        <Button Content="Додати товар" Command="{Binding AddCommand}" Margin="0,10,0,0" />
    </StackPanel>
    </ScrollViewer>
</Window>
